@@ -0,0 +1,30 @@
+#!/bin/sh
+#
+# Start the network....
+#
+
+case "$1" in
+  start)
+ 	echo "Starting usb ether..."
+
+
+    host_addr="80:38:FD:83:13:37"
+    dev_addr="80:38:FD:80:13:37"
+
+	modprobe g_ether host_addr=$host_addr dev_addr=$dev_addr
+	;;
+  stop)
+	echo -n "Stopping network..."
+	/sbin/ifconfig usb0 down
+	modprobe -r g_ether
+	;;
+  restart|reload)
+	"$0" stop
+	"$0" start
+	;;
+  *)
+	echo "Usage: $0 {start|stop|restart}"
+	exit 1
+esac
+
+exit $?
diff --git a/board/leapfrog/lfx000/fsoverlay_surgeon/etc/init.d/S45udhcpd b/board/leapfrog/lfx000/fsoverlay_surgeon/etc/init.d/S45udhcpd
new file mode 100755
index 00000000000..d2f06ae7562
--- /dev/null
+++ b/board/leapfrog/lfx000/fsoverlay_surgeon/etc/init.d/S45udhcpd
@@ -0,0 +1,39 @@
+#! /bin/sh
+
+[ -f /usr/sbin/udhcpd ] || exit 0
+
+start() {
+	printf "Starting udhcpd: "
+	udhcpd -S /etc/udhcpd.conf
+	echo "done"
+}
+
+
+stop() {
+	printf "Stopping udhcpd: "
+	killall udhcpd
+	echo "done"
+}
+
+restart() {
+	stop
+	start
+}
+
+# See how we were called.
+case "$1" in
+  start)
+	start
+	;;
+  stop)
+	stop
+	;;
+  restart|reload)
+	restart
+	;;
+  *)
+	echo "Usage: $0 {start|stop|reload|restart}"
+	exit 1
+esac
+
+exit $?
