diff --git a/board/leapfrog/lfx000/fsoverlay/etc/init.d/S35usbether b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S35usbether
new file mode 100755
index 00000000000..81a0dcd0a99
--- /dev/null
+++ b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S35usbether
@@ -0,0 +1,30 @@
+#!/bin/sh
+#
+# Start the network....
+#
+
+case "$1" in
+  start)
+ 	echo "Starting usb ether..."
+
+
+    host_addr="80:38:FD:83:13:37"
+    dev_addr="80:38:FD:80:13:37"
+
+	modprobe g_ether host_addr=$host_addr dev_addr=$dev_addr
+	;;
+  stop)
+	echo -n "Stopping network..."
+	/sbin/ifconfig usb0 down
+	modprobe -r g_ether
+	;;
+  restart|reload)
+	"$0" stop
+	"$0" start
+	;;
+  *)
+	echo "Usage: $0 {start|stop|restart}"
+	exit 1
+esac
+
+exit $?
diff --git a/board/leapfrog/lfx000/fsoverlay/etc/init.d/S45udhcpd b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S45udhcpd
new file mode 100755
index 00000000000..d2f06ae7562
--- /dev/null
+++ b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S45udhcpd
@@ -0,0 +1,39 @@
+#! /bin/sh
+
+[ -f /usr/sbin/udhcpd ] || exit 0
+
+start() {
+	printf "Starting udhcpd: "
+	udhcpd -S /etc/udhcpd.conf
+	echo "done"
+}
+
+
+stop() {
+	printf "Stopping udhcpd: "
+	killall udhcpd
+	echo "done"
+}
+
+restart() {
+	stop
+	start
+}
+
+# See how we were called.
+case "$1" in
+  start)
+	start
+	;;
+  stop)
+	stop
+	;;
+  restart|reload)
+	restart
+	;;
+  *)
+	echo "Usage: $0 {start|stop|reload|restart}"
+	exit 1
+esac
+
+exit $?
diff --git a/board/leapfrog/lfx000/fsoverlay/etc/init.d/S50mount_data_mmc b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S50mount_data_mmc
new file mode 100755
index 00000000000..9f270d357c6
--- /dev/null
+++ b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S50mount_data_mmc
@@ -0,0 +1,55 @@
+#!/bin/sh
+BULK_PART="/dev/mmcblk0p4"
+MOUNT_POINT=/roms
+
+case "$1" in
+	start)
+
+		if grep $MOUNT_POINT /proc/mounts > /dev/null; then
+			echo "Data already mounted. Is this an MTD-based system with an SD card attached?"
+			exit 0;
+		fi
+
+		if [ ! -f "$BULK_PART" ]; then
+			echo "Bulk NAND partition not found. Probably an MMC system."
+			exit 0;
+		fi
+
+		if [ ! -e $MOUNT_POINT ]; then
+			echo "Mount point $MOUNT_POINT missing."
+			exit 1
+		fi
+
+		echo "Mounting Data partition."
+
+		mount -t ext4 -o rw $BULK_PART $MOUNT_POINT
+		if [ $? != 0 ]; then
+			echo "Mounting Data failed."
+			exit 1
+		fi
+		;;
+	stop)
+
+		echo "Unmounting Data partition."
+
+		if grep $MOUNT_POINT /proc/mounts > /dev/null; then 
+			umount $MOUNT_POINT 
+			if [ $? != 0 ]; then
+				echo "Unmounting Data failed."
+				exit 1
+			fi
+		else
+			echo "Data not mounted."
+		fi
+		;;
+
+	restart)	
+		$0 stop
+		$0 start
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}"
+		exit 1
+		;;
+esac
+exit 0
diff --git a/board/leapfrog/lfx000/fsoverlay/etc/init.d/S50mount_data_mtd b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S50mount_data_mtd
new file mode 100755
index 00000000000..cbccdaaf353
--- /dev/null
+++ b/board/leapfrog/lfx000/fsoverlay/etc/init.d/S50mount_data_mtd
@@ -0,0 +1,70 @@
+#!/bin/sh
+BULK_PART=`awk -e '$4 ~ /"Bulk"/ {print "/dev/" substr($1, 1, length($1)-1)}' /proc/mtd`
+MOUNT_POINT=/roms
+
+case "$1" in
+	start)
+
+		if grep $MOUNT_POINT /proc/mounts > /dev/null; then
+			echo "Data already mounted."
+			exit 0;
+		fi
+
+		if [ -z ${BULK_PART}; then
+			echo "Bulk NAND partition not found. Probably an MMC system."
+			exit 0;
+		fi
+
+		if [ ! -e $MOUNT_POINT ]; then
+			echo "Mount point $MOUNT_POINT missing."
+			exit 1
+		fi
+
+		echo "Mounting Data partition."
+
+		ubiattach /dev/ubi_ctrl -p $BULK_PART
+		if [ $? != 0 ]; then
+			echo "Attaching Data UBI failed."
+			exit 1
+		fi
+
+		mount -t ubifs -o rw ubi1_0 $MOUNT_POINT
+		if [ $? != 0 ]; then
+			echo "Mounting Data failed."
+			exit 1
+		fi
+		;;
+	stop)
+
+		echo "Unmounting Data partition."
+
+		if grep $MOUNT_POINT /proc/mounts > /dev/null; then 
+			umount $MOUNT_POINT 
+			if [ $? != 0 ]; then
+				echo "Unmounting Data failed."
+				exit 1
+			fi
+
+			if [ -e /sys/class/ubi/ubi1 ]; then
+				ubidetach /dev/ubi_ctrl -d 1
+			fi
+			if [ $? != 0 ]; then
+				echo "Detaching Data UBI failed."
+				exit 1
+			fi
+
+		else
+			echo "Data not mounted."
+		fi
+		;;
+
+	restart)	
+		$0 stop
+		$0 start
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}"
+		exit 1
+		;;
+esac
+exit 0
