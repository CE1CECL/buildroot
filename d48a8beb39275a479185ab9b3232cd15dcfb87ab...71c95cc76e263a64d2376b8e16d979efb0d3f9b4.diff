diff --git a/package/libretro-stella/libretro-stella-000-makefile.patch b/package/libretro-stella/libretro-stella-000-makefile.patch
new file mode 100644
index 00000000000..092bb4cbd98
--- /dev/null
+++ b/package/libretro-stella/libretro-stella-000-makefile.patch
@@ -0,0 +1,31 @@
+--- a/Makefile	2017-01-20 21:00:24.000000000 +0100
++++ b/Makefile	2017-01-22 15:25:40.988735238 +0100
+@@ -195,6 +195,28 @@
+ 	FLAGS += -marm -mcpu=cortex-a53 -mfpu=neon-fp-armv8 -mfloat-abi=hard
+ 	FLAGS += -fomit-frame-pointer -ffast-math
+ 
++# ARM
++else ifneq (,$(findstring armv,$(platform)))
++	TARGET := $(TARGET_NAME)_libretro.so
++	SHARED := -shared -Wl,--no-undefined -Wl,--version-script=link.T
++	FLAGS += -fomit-frame-pointer -ffast-math
++	fpic := -fPIC
++	CC = gcc
++ifneq (,$(findstring cortexa8,$(platform)))
++	FLAGS += -marm -mcpu=cortex-a8
++else ifneq (,$(findstring cortexa9,$(platform)))
++	FLAGS += -marm -mcpu=cortex-a9
++endif
++	FLAGS += -marm
++ifneq (,$(findstring neon,$(platform)))
++	FLAGS += -mfpu=neon
++endif
++ifneq (,$(findstring softfloat,$(platform)))
++	FLAGS += -mfloat-abi=softfp
++else ifneq (,$(findstring hardfloat,$(platform)))
++	FLAGS += -mfloat-abi=hard
++endif
++
+ # emscripten
+ else ifeq ($(platform), emscripten)
+ 	TARGET := $(TARGET_NAME)_libretro_$(platform).bc
